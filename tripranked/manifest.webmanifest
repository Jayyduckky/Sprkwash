{
  "name": "TripRanked — Drive. Track. Rank.",
  "short_name": "TripRanked",
  "description": "Track your drives with GPS — live speed, distance, driving stats, trip history, shareable stat cards and global leaderboards.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
